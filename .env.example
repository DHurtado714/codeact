# Copy this file to .env and fill in real values. .env is gitignored.

# "anthropic" | "openai" (the "openai" provider is used for any
# OpenAI-compatible endpoint: OpenAI itself, OpenRouter, Groq, Together,
# DeepSeek, Ollama, ...)
LLM_PROVIDER=openai

# Leave empty to use the provider's default API. Set it to point at an
# OpenAI-compatible endpoint other than api.openai.com, e.g. OpenRouter:
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model name as expected by the endpoint above.
LLM_MODEL=anthropic/claude-sonnet-4.5

LLM_API_KEY=

# Optional, only used by the "openai" provider. OpenRouter uses these two
# to attribute usage; harmless no-ops against any other endpoint.
LLM_HTTP_REFERER=
LLM_TITLE=
